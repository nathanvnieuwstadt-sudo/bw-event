# Supabase connection string (use the pooled/transaction-mode connection, port 6543)
# Found in Supabase dashboard: Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRATION_MS=86400000
